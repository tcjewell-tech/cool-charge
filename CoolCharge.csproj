<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Windows x64 only: keeps the Linux/macOS/Android native folders out of the output that gets installed -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- The app runs elevated from the user's session. Self-contained so it can't be pointed at another .NET
         runtime through DOTNET_ROOT, and no startup hooks so DOTNET_STARTUP_HOOKS can't load code into it. -->
    <SelfContained>true</SelfContained>
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <!-- 0.9.6 reads MSRs through the PawnIO driver (winget install namazso.PawnIO), not WinRing0 -->
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>

</Project>
